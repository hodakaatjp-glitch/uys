---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="uys.">
	<section class="hero">
		<span class="eyebrow">MARKETING NOTES</span>
		<h1>限られた予算と人手でも、<br />お客さんに届く発信を。</h1>
		<p>
			中小の飲食店・温泉施設が、日々の運営をしながらでも実践できる集客・マーケティングの知見をまとめています。
		</p>
	</section>

	<ul class="posts">
		{posts.map((post) => (
			<li>
				<a class="card" href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>
					<p class="date">
						{post.data.pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
					</p>
					<h2>{post.data.title}</h2>
					<p class="desc">{post.data.description}</p>
					{post.data.tags.length > 0 && (
						<p class="tags">
							{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
						</p>
					)}
					<span class="read-more">続きを読む &rarr;</span>
				</a>
			</li>
		))}
	</ul>

	{posts.length === 0 && <p>まだ記事がありません。近日公開予定です。</p>}
</BaseLayout>

<style>
	.hero {
		padding: 8px 0 48px;
		border-bottom: 1px solid var(--hairline);
		margin-bottom: 40px;
	}
	.eyebrow {
		display: inline-block;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--accent);
		margin-bottom: 18px;
	}
	.hero h1 {
		font-family: var(--serif);
		font-size: clamp(28px, 4.4vw, 42px);
		line-height: 1.5;
		font-weight: 800;
		margin: 0 0 20px;
	}
	.hero p {
		color: var(--ink-soft);
		font-size: 16px;
		max-width: 46ch;
		margin: 0;
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 18px;
	}

	.card {
		display: block;
		background: var(--surface);
		border: 1px solid var(--hairline);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		padding: 28px 30px;
		text-decoration: none;
		color: var(--ink);
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}
	.card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-hover);
		border-color: color-mix(in srgb, var(--accent) 35%, var(--hairline));
	}

	.date {
		margin: 0 0 10px;
		font-size: 13px;
		color: var(--ink-faint);
		letter-spacing: 0.02em;
	}
	.card h2 {
		font-family: var(--serif);
		font-size: 22px;
		font-weight: 700;
		margin: 0 0 10px;
		line-height: 1.5;
	}
	.desc {
		margin: 0 0 16px;
		color: var(--ink-soft);
		font-size: 15px;
		line-height: 1.75;
	}
	.tags {
		margin: 0 0 14px;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.tag {
		font-size: 12px;
		font-weight: 500;
		color: var(--accent);
		background: var(--accent-soft);
		padding: 4px 11px;
		border-radius: 999px;
	}
	.read-more {
		font-size: 13px;
		font-weight: 700;
		color: var(--accent);
	}
</style>
